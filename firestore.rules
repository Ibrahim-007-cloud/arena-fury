rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validFighter(f) {
      return f.name is string
        && f.name.size() > 0 && f.name.size() <= 16
        && f.movesetId in ['striker', 'brawler', 'ninja', 'tempest']
        && f.costumeId in ['gi', 'street', 'armor', 'ninja']
        && f.stats.power + f.stats.speed + f.stats.defense <= 10;
    }

    // Player profile + aggregate record
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Custom fighters (max 2 custom + 4 built-in = 6 roster slots; enforced in app)
      match /fighters/{fighterId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validFighter(request.resource.data);
      }

      // Match history is append-only
      match /matches/{matchId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // Public leaderboard (one doc per player, written by that player)
    // NOTE: client-written scores can be faked. For a production game move
    // this write into a Cloud Function triggered by /users/{uid}/matches.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }
  }
}
